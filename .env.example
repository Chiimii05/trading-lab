# Copia este archivo como .env y rellénalo. El .env nunca se sube a git.

# --- Cuenta de MetaTrader 5 ---
# Usa la CONTRASEÑA DE INVERSOR (solo lectura): basta para descargar historial y usar el
# probador, y con ella el laboratorio no puede abrir ni cerrar operaciones.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Ruta a terminal64.exe (opcional si solo tienes un MT5 instalado)
MT5_TERMINAL_PATH=

# --- Qué probar ---
# Símbolos separados por coma, con el nombre exacto de tu broker
SYMBOLS=EURUSD,USDJPY,XAUUSD
# Desde qué fecha descargar historial (hace falta margen para optimizar antes del walk-forward)
HISTORY_FROM=2022-01-01
